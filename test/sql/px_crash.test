# name: test/sql/px_crash.test
# description: crash handling and validation
# group: [sql]

require px

statement ok
PRAGMA enable_verification

# valid minimal should work
query I
SELECT COUNT(*) FROM read_px('test/data/crash/valid_minimal.px')
----
4

# decimals 9 parsing (bug <'9' previously failed for 9)
query I
SELECT COUNT(*) FROM read_px('test/data/crash/decimals_nine.px')
----
4

query I
SELECT COUNT(*) FROM read_px('test/data/crash/codes_with_9.px')
----
4

# truncated DATA: only 1 value for 4 expected, remaining should be NULL not crash
query II
SELECT COUNT(*), COUNT(value) FROM read_px('test/data/crash/truncated_data.px')
----
4	1

# large exponent should not hang or crash, should produce value or float
query I
SELECT COUNT(*) FROM read_px('test/data/crash/large_exponent.px')
----
4

# mismatch VALUES/CODES count should error not crash
statement error
SELECT * FROM read_px('test/data/crash/mismatch_values_codes.px')
----
Binder Error

# empty file should error
statement error
SELECT * FROM read_px('test/data/crash/empty.px')
----
Binder Error

# no variables (no STUB/HEADING) should error not crash/underflow
statement error
SELECT * FROM read_px('test/data/crash/no_vars.px')
----
Binder Error

# missing semicolon is tolerated but should not OOB/crash (currently succeeds)
statement ok
SELECT * FROM read_px('test/data/crash/no_semicolon.px')

# unclosed quote should error not OOB read
statement error
SELECT * FROM read_px('test/data/crash/unclosed_quote.px')
----
Binder Error

# missing CODES should error (zero codes -> div by zero)
statement error
SELECT * FROM read_px('test/data/crash/no_codes.px')
----
Binder Error

# empty CODES should error
statement error
SELECT * FROM read_px('test/data/crash/empty_codes.px')
----
Binder Error

# too many codes (>2048) should error with limit, not heap corruption
statement error
SELECT * FROM read_px('test/data/crash/many_codes.px')
----
Binder Error

# missing DATA keyword should error not infinite loop
statement error
SELECT * FROM read_px('test/data/crash/missing_data_keyword.px')
----
Binder Error

# file not found already handled
statement error
SELECT * FROM read_px('test/data/crash/does_not_exist.px')
----
not found

# also test that file with many rows still correct after first block (regression)
query I
SELECT COUNT(*) FROM read_px('test/data/statfin_vaerak_pxt_11rc.px') WHERE vuosi='1900'
----
57

# a CODES keyword for a variable that already has one used to be appended to
# that variable, which left the file with more observations than it has
# combinations of codes
statement error
SELECT * FROM read_px('test/data/crash/duplicate_codes.px')
----
Duplicate CODES

statement error
SELECT * FROM read_px('test/data/crash/duplicate_values.px')
----
Duplicate VALUES

# ISO-8859-1 characters of a codes list have to be converted, handing the raw
# bytes to DuckDB aborted the query with an internal error
query III
SELECT var1, length(var1), value FROM read_px('test/data/crash/latin1_codes.px') ORDER BY value
----
café	4	1
naïve	5	2
Über	4	3

query II
SELECT variable, code FROM read_px_metadata('test/data/crash/latin1_codes.px') ORDER BY code
----
var1	café
var1	naïve
var1	Über

# a file that is UTF-8 already is left alone
query II
SELECT var1, value FROM read_px('test/data/crash/utf8_codes.px') ORDER BY value
----
Työmarkkinat	1
työ	2

# bytes that are not UTF-8 at all must not reach DuckDB as they are, it aborts
# the query with an internal error when it meets them in a VARCHAR
query III
SELECT length(var1), hex(var1), value FROM read_px('test/data/crash/invalid_utf8_codes.px') ORDER BY value
----
3	C280C281C3BE	1
5	706C61696E	2

query II
SELECT hex(variable), hex(code) FROM read_px_metadata('test/data/crash/invalid_utf8_stub.px')
----
76C2807231	61
76C2807231	62

# an exponent of a negative number used to be ignored, 1e-40 was read as 1
query R
SELECT value FROM read_px('test/data/crash/negative_exponent.px')
----
10000000000.0
1.5e-05
2e+20
3e-20

# NULL is not a file name
statement error
SELECT * FROM read_px(NULL)
----
Binder Error

statement error
SELECT * FROM read_px_metadata(NULL)
----
Binder Error
